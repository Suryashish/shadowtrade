# Account that sends relayed withdrawals, posts ASP roots and drips gas. Server only; never commit it.
RELAYER_PRIVATE_KEY=
# Its address, used as the fee recipient the relayer accepts. Defaults to the testnet relayer.
NEXT_PUBLIC_RELAYER_ADDRESS=
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_SITE_URL=
# Kuru spot is off until we have testnet USDC; set to true to re-enable it.
NEXT_PUBLIC_ENABLE_KURU=false
# Comma-separated depositor addresses the ASP refuses to approve (screening stub).
ASP_DENYLIST=
# Number of trusted reverse proxies in front of the app (e.g. 1 on Vercel). Per-IP rate limits read the client IP
# from x-forwarded-for only when this is >= 1; with 0 all callers share one limit bucket.
TRUSTED_PROXY_HOPS=0
